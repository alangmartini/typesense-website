    rule_name = 'product_queries_aggregation'
    rule_configuration = {
      'name' => rule_name,
      'type' => 'popular_queries',
      'collection' => 'products',
      'event_type' => 'search',
      'params' => {
        'destination_collection' => 'product_queries',
